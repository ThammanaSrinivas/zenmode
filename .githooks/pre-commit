#!/usr/bin/env bash
# Blocks commits into this PUBLIC repo that carry private content or obvious secrets.
# Wired via: git config core.hooksPath .githooks (done once by zenmode-brain/setup.sh).
#
# This is a floor, not a guarantee: it only catches content carrying the CONFIDENTIAL marker
# (the convention private docs in zenmode-brain / zenmode_core_private are supposed to start
# with) or a small set of recognizable secret shapes. It does not scan for arbitrary sensitive
# prose that carries no marker.
set -euo pipefail

diff_content="$(git diff --cached -U0 --no-color -- . ':(exclude).githooks/pre-commit')"

fail=0

if echo "$diff_content" | grep -nE '^\+.*(CONFIDENTIAL)' >/dev/null; then
  echo "error: staged changes contain a CONFIDENTIAL marker — this is the public zenmode repo." >&2
  echo "       offending lines:" >&2
  echo "$diff_content" | grep -nE '^\+.*(CONFIDENTIAL)' >&2
  fail=1
fi

if echo "$diff_content" | grep -nE '^\+.*(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AIzaSy[0-9A-Za-z_-]{33}|AKIA[0-9A-Z]{16})' >/dev/null; then
  echo "error: staged changes look like they contain a private key or API key." >&2
  echo "       offending lines:" >&2
  echo "$diff_content" | grep -nE '^\+.*(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AIzaSy[0-9A-Za-z_-]{33}|AKIA[0-9A-Z]{16})' >&2
  fail=1
fi

if [ "$fail" -eq 1 ]; then
  echo "" >&2
  echo "Commit rejected. If this is a false positive, remove the marker/pattern from the diff" >&2
  echo "or (rare, deliberate) commit with --no-verify." >&2
  exit 1
fi

# Architectural choke point: app/ must reach backends only through
# ServiceLocator (core-api), never by importing Firebase/PostHog SDK classes
# or declaring their dependencies directly. scripts/*.sh are the single
# source of truth for these checks - also called by CI, the Claude Code
# PostToolUse hook, and tests/guardrails/.
staged_boundary_files=$(git diff --cached --name-only --diff-filter=ACM -- ':(glob)app/src/**/*.kt' app/build.gradle.kts || true)
if [ -n "$staged_boundary_files" ]; then
  if ! echo "$staged_boundary_files" | xargs ./scripts/check-app-boundary.sh; then
    fail=1
  fi
fi

# SOURCE OF TRUTH: architectural choke points. If either file is staged,
# make sure the [WHAT]/[WHY]/[HOW]/[WHERE] micro-context tags weren't
# accidentally stripped - mirrors the same CI step.
choke_point_files="core-api/src/main/java/com/zenlauncher/zenmode/coreapi/services/ServiceLocator.kt app/src/main/java/com/zenlauncher/zenmode/ZenModeApp.kt"
staged_choke_points=""
for f in $choke_point_files; do
  if git diff --cached --name-only | grep -qx "$f"; then
    staged_choke_points="$staged_choke_points $f"
  fi
done
if [ -n "$staged_choke_points" ]; then
  if ! ./scripts/check-choke-point-tags.sh; then
    fail=1
  fi
fi

# 1000-line ceiling on source files - see scripts/check-line-limit.sh for rationale.
staged_src_files=$(git diff --cached --name-only --diff-filter=ACM -- ':(glob)app/src/**/*.kt' ':(glob)core-api/src/**/*.kt' ':(glob)core-mock/src/**/*.kt' || true)
if [ -n "$staged_src_files" ]; then
  if ! echo "$staged_src_files" | xargs ./scripts/check-line-limit.sh; then
    fail=1
  fi
fi

if [ "$fail" -eq 1 ]; then
  echo "" >&2
  echo "Commit rejected. If this is a false positive, remove the marker/pattern from the diff" >&2
  echo "or (rare, deliberate) commit with --no-verify." >&2
  exit 1
fi

exit 0
