<?xml version="1.0" encoding="utf-8"?>
<!--
  ZenMode OS v3 primitives. Source of truth: zenmode.figmatokens.json in the
  brand kit. Semantic light/dark mapping lives in ui/theme/Color.kt — these are
  raw values only, never referenced directly from Compose.
-->
<resources>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- zen · the working accent -->
    <color name="zen_900">#0B5C12</color>
    <color name="zen_700">#0F7A18</color>
    <color name="zen_500">#2AA136</color>
    <color name="zen_300">#5BDF62</color>
    <color name="zen_200">#D9F7DB</color>
    <color name="zen_100">#BFF3C2</color>
    <color name="zen_050">#E6F6E7</color>
    <color name="zen_ink">#1D3A20</color>
    <color name="zen_on">#F2FFF2</color>

    <!-- amber · the single reward hue -->
    <color name="amber_800">#7A5A00</color>
    <color name="amber_500">#FFC800</color>
    <color name="amber_on">#FFF8E1</color>

    <!-- ember · deduction -->
    <color name="ember_700">#B34700</color>
    <color name="ember_500">#FF6600</color>
    <color name="ember_300">#FF8A3D</color>
    <color name="ember_on">#FFF3EA</color>

    <!-- ink · dark mode base -->
    <color name="ink_base">#111111</color>
    <color name="ink_surface">#1A1A1A</color>
    <color name="ink_raised">#222222</color>
    <color name="ink_gain">#16210F</color>
    <color name="ink_line">#2B2B2B</color>
    <color name="ink_soft">#4C4C48</color>

    <!-- ink tints for the mood backgrounds. Not in the token file — derived to
         sit at the same remove from ink_base as ink_gain does. -->
    <color name="ink_reward">#221D0A</color>
    <color name="ink_deduct">#241408</color>

    <!-- paper · light mode base -->
    <color name="paper_base">#F2F1ED</color>
    <color name="paper_raised">#FAF9F5</color>
    <color name="paper_sunk">#EAE8E2</color>
    <color name="paper_white">#FFFFFF</color>
    <color name="paper_ink">#F5F5F1</color>
    <color name="paper_hairline">#DBD9D2</color>

    <!-- stone · neutrals -->
    <color name="stone_600">#5E6058</color>
    <color name="stone_500">#70726A</color>
    <color name="stone_400">#8C8E86</color>
    <color name="stone_300">#9E9E98</color>
    <color name="stone_250">#7E7E78</color>
    <color name="stone_200">#DCDCD6</color>

    <!-- Home screen mood washes. Three vertical gradients, sampled straight off the v3
         home render: cream at the edges, the mood colour pooling in the middle. -->
    <color name="wash_happy_edge">#EEF0E3</color>
    <color name="wash_happy_core">#D6E99F</color>
    <color name="wash_neutral_edge">#F2F0E4</color>
    <color name="wash_neutral_core">#F6E9A8</color>
    <color name="wash_annoyed_edge">#F4EDE6</color>
    <color name="wash_annoyed_core">#F7C9B4</color>

    <color name="wash_happy_edge_dark">#101410</color>
    <color name="wash_happy_core_dark">#16210F</color>
    <color name="wash_neutral_edge_dark">#141208</color>
    <color name="wash_neutral_core_dark">#221D0A</color>
    <color name="wash_annoyed_edge_dark">#150C06</color>
    <color name="wash_annoyed_core_dark">#241408</color>

    <!-- Stat card fills. Face colour at the top, body beneath. -->
    <color name="card_happy_face">#B9E234</color>
    <color name="card_happy_body">#C8E66D</color>
    <color name="card_neutral_face">#EBDE28</color>
    <color name="card_neutral_body">#EFE39A</color>
    <color name="card_annoyed_face">#F1634F</color>
    <color name="card_annoyed_body">#E1AF7A</color>

    <!-- The score orange. Reads on the light wash where zen green would not. -->
    <color name="score_orange">#FE6801</color>
    <color name="fire_red">#FF3A00</color>

    <!-- consumed from View-based code (AppLogic, SegmentedProgressBar) -->
    <color name="zen_mindfulness_happy">#0F7A18</color>
    <color name="zen_mindfulness_neutral">#FFC800</color>
    <color name="zen_mindfulness_annoyed">#FF6600</color>
</resources>
